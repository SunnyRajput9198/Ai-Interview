# Copy this file to .env and fill in your values.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL with pgvector extension required.
# Local Docker PostgreSQL (see the repository's docker-compose.yml).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ai_interviewer?schema=public"

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Used for voice interviews (Realtime API) AND document embeddings (text-embedding-3-small).
OPENAI_KEY="sk-proj-replace_with_your_openai_api_key"

# ─── Deepgram ─────────────────────────────────────────────────────────────────
# Used for live speech-to-text transcription during voice interviews.
DEEPGRAM_API_KEY="your_deepgram_api_key_here"

# ─── Document Upload ──────────────────────────────────────────────────────────
# Maximum upload size in MB. Default: 20
MAX_DOCUMENT_SIZE_MB=20
